<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VideoEditor.Desktop.MainWindow"
        Title="Video Editor"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextBrush}">

    <Grid RowDefinitions="Auto,*,180,Auto">

        <!-- ===== Topbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🎬 Video Editor" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                <Border Width="1" Background="{StaticResource LineBrush}" Margin="6,2"/>
                <Button x:Name="openBtn" Content="Open files…" Click="OpenFiles_Click"/>
                <Button x:Name="exportBtn" Content="Export…" IsEnabled="False"/>
                <TextBlock x:Name="platformText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="11.5"/>
            </StackPanel>
        </Border>

        <!-- ===== Main content: tools | preview | inspector ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*,300">

            <!-- Left tools -->
            <Border Grid.Column="0" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="CLIPS" Foreground="{StaticResource TextMuteBrush}" FontSize="11" FontWeight="Bold"/>
                    <ListBox x:Name="clipList" Background="Transparent" BorderThickness="0" Height="400"/>
                </StackPanel>
            </Border>

            <!-- Center preview -->
            <Border Grid.Column="1" Background="{StaticResource Bg0Brush}" Padding="16">
                <Border Background="Black" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Panel>
                        <Image x:Name="previewImage" Stretch="Uniform"/>
                        <TextBlock x:Name="previewHint" Text="Open a video to preview it here"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="13"/>
                    </Panel>
                </Border>
            </Border>

            <!-- Right inspector -->
            <Border Grid.Column="2" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="INSPECTOR" Foreground="{StaticResource TextMuteBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Select a clip to edit it." Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Timeline ===== -->
        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Spacing="6">
                <TextBlock Text="TIMELINE" Foreground="{StaticResource TextMuteBrush}" FontSize="11" FontWeight="Bold"/>
                <Border Background="{StaticResource Bg0Brush}" CornerRadius="4" Height="120" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <TextBlock Text="Timeline goes here (Stage C)" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="3" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="statusText" Text="Ready." Foreground="{StaticResource TextMuteBrush}" FontSize="11.5"/>
        </Border>
    </Grid>
</Window>
