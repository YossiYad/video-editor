<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VideoEditor</AssemblyName>
    <RootNamespace>VideoEditor</RootNamespace>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.9.1</Version>
    <AssemblyVersion>1.9.1.0</AssemblyVersion>
    <FileVersion>1.9.1.0</FileVersion>
    <InformationalVersion>1.9.1</InformationalVersion>
    <UpdateDesktopShortcut Condition="'$(UpdateDesktopShortcut)' == ''">true</UpdateDesktopShortcut>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <!-- Bundle the native WPF DLLs (D3DCompiler / PresentationNative / wpfgfx /
         PenImc / vcruntime) into the single-file EXE so it can run from a folder
         that only contains VideoEditor.exe. They're extracted to a temp folder on
         first launch. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xabe.FFmpeg" Version="5.2.6" />
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="5.2.6" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- Local, free GPU/CPU inference for the AI camera background (MODNet matting).
         The model itself auto-downloads on first use, like FFmpeg / Whisper. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoEditor.Core\VideoEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Tools\" />
    <!-- Bundle the .ico as a WPF Resource so MainWindow's Icon="icon.ico" binding
         finds it at runtime (the ApplicationIcon csproj setting above is enough for
         the EXE icon in Explorer, but the Window also wants its own copy). -->
    <Resource Include="icon.ico" />
  </ItemGroup>

  <Target Name="UpdateDesktopShortcutAfterBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(UpdateDesktopShortcut)' == 'true'">
    <PropertyGroup>
      <DesktopShortcutTarget>$(TargetDir)$(AssemblyName).exe</DesktopShortcutTarget>
    </PropertyGroup>
    <Exec Condition="Exists('$(DesktopShortcutTarget)')" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$target = '$(DesktopShortcutTarget)'; $shortcutPath = Join-Path ([Environment]::GetFolderPath('DesktopDirectory')) 'VideoEditor.lnk'; $shell = New-Object -ComObject WScript.Shell; $shortcut = $shell.CreateShortcut($shortcutPath); $shortcut.TargetPath = $target; $shortcut.Arguments = ''; $shortcut.WorkingDirectory = Split-Path -Parent $target; $shortcut.IconLocation = $target + ',0'; $shortcut.Save(); Write-Host ('Updated shortcut: ' + $shortcutPath + ' -> ' + $target)&quot;" ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="UpdateDesktopShortcutAfterPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' and '$(UpdateDesktopShortcut)' == 'true'">
    <PropertyGroup>
      <DesktopShortcutTarget>$(PublishDir)$(AssemblyName).exe</DesktopShortcutTarget>
    </PropertyGroup>
    <Exec Condition="Exists('$(DesktopShortcutTarget)')" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$target = '$(DesktopShortcutTarget)'; $shortcutPath = Join-Path ([Environment]::GetFolderPath('DesktopDirectory')) 'VideoEditor.lnk'; $shell = New-Object -ComObject WScript.Shell; $shortcut = $shell.CreateShortcut($shortcutPath); $shortcut.TargetPath = $target; $shortcut.Arguments = ''; $shortcut.WorkingDirectory = Split-Path -Parent $target; $shortcut.IconLocation = $target + ',0'; $shortcut.Save(); Write-Host ('Updated shortcut: ' + $shortcutPath + ' -> ' + $target)&quot;" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
