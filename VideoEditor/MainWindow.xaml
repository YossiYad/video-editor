<Window x:Class="VideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VideoEditor.Controls"
        Title="Video Editor" Height="860" Width="1440" Background="#0B0B14"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#161624" Padding="8" BorderBrush="#2A2A3E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="openBtn" Content="📂 Add Videos" Style="{StaticResource PrimaryButton}" Click="OpenBtn_Click"/>
                <Button x:Name="saveBtn" Content="💾 Export" Style="{StaticResource PrimaryButton}" Click="SaveBtn_Click"/>
                <Separator Margin="8,2" Background="#3A3A52" Width="1"/>
                <Button x:Name="splitBtn" Content="✂ Split (S)" Style="{StaticResource ToolButton}" Click="Split_Click" ToolTip="Split selected clip at playhead (S key)"/>
                <Button x:Name="splitNBtn" Content="✂ Split into N…" Style="{StaticResource ToolButton}" Click="SplitN_Click" ToolTip="Split selected clip into N equal parts"/>
                <Separator Margin="8,2" Background="#3A3A52" Width="1"/>
                <Button x:Name="addBlockBtn" Content="◼ Add Block" Style="{StaticResource ToolButton}" Click="AddBlock_Click"/>
                <Button x:Name="deleteBlockBtn" Content="🗑 Delete Block" Style="{StaticResource ToolButton}" Click="DeleteBlock_Click"/>
                <Separator Margin="8,2" Background="#3A3A52" Width="1"/>
                <TextBlock x:Name="filePath" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="8,0" Text="Drop video files anywhere to add"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Tools Panel -->
            <Border Background="#161624" BorderBrush="#2A2A3E" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Quick Tools" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="Click a tool to apply on current/selected clip" Foreground="#A0A0B0" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button x:Name="btnScreenRec" Content="🖥 Screen Recorder" Style="{StaticResource ToolButton}" Click="ScreenRec_Click"/>
                        <Button x:Name="btnTts" Content="🎙 Text to Speech" Style="{StaticResource ToolButton}" Click="Tts_Click"/>
                        <Button x:Name="btnMerge" Content="🔗 Merge All Clips" Style="{StaticResource ToolButton}" Click="Merge_Click"/>
                        <Button x:Name="btnRecord" Content="🎥 Video Recorder" Style="{StaticResource ToolButton}" Click="Record_Click"/>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="On Selected Clip" Style="{StaticResource HeaderText}"/>
                        <Button x:Name="btnTrim" Content="✂ Trim" Style="{StaticResource ToolButton}" Click="Trim_Click"/>
                        <Button x:Name="btnSpeed" Content="⏩ Change Speed" Style="{StaticResource ToolButton}" Click="Speed_Click"/>
                        <Button x:Name="btnVolume" Content="🔊 Change Volume" Style="{StaticResource ToolButton}" Click="Volume_Click"/>
                        <Button x:Name="btnRotate" Content="↻ Rotate" Style="{StaticResource ToolButton}" Click="Rotate_Click"/>
                        <Button x:Name="btnFlip" Content="⇄ Flip" Style="{StaticResource ToolButton}" Click="Flip_Click"/>
                        <Button x:Name="btnCrop" Content="✄ Crop" Style="{StaticResource ToolButton}" Click="Crop_Click"/>
                        <Button x:Name="btnResize" Content="⛶ Resize Output" Style="{StaticResource ToolButton}" Click="Resize_Click"/>
                        <Button x:Name="btnLoop" Content="🔁 Loop Clip" Style="{StaticResource ToolButton}" Click="Loop_Click"/>
                        <Button x:Name="btnStabilize" Content="🤚 Stabilize" Style="{StaticResource ToolButton}" Click="Stabilize_Click"/>
                        <Button x:Name="btnAddImage" Content="🖼 Add Image" Style="{StaticResource ToolButton}" Click="AddImage_Click"/>
                        <Button x:Name="btnAddText" Content="🔤 Add Text" Style="{StaticResource ToolButton}" Click="AddText_Click"/>
                        <Button x:Name="btnRemoveLogo" Content="🚫 Remove Logo" Style="{StaticResource ToolButton}" Click="RemoveLogo_Click"/>
                        <Button x:Name="btnAddAudio" Content="🎵 Add Audio Track" Style="{StaticResource ToolButton}" Click="AddAudio_Click"/>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="Audio" Style="{StaticResource HeaderText}"/>
                        <Button x:Name="btnExtractAudioClip" Content="🎵 Extract Audio (Clip)" Style="{StaticResource ToolButton}" Click="ExtractAudioClip_Click" ToolTip="Save the audio from the selected clip as an audio file (MP3/WAV/M4A)"/>
                        <Button x:Name="btnExtractAudioProject" Content="🎵 Extract Audio (Project)" Style="{StaticResource ToolButton}" Click="ExtractAudioProject_Click" ToolTip="Save the audio of the entire project as one audio file"/>
                        <Button x:Name="btnMuteClip" Content="🔇 Mute Clip" Style="{StaticResource ToolButton}" Click="MuteClip_Click" ToolTip="Silence the selected clip"/>
                        <Button x:Name="btnUnmuteClip" Content="🔊 Restore Audio" Style="{StaticResource ToolButton}" Click="UnmuteClip_Click" ToolTip="Restore audio of selected clip"/>
                        <Button x:Name="btnRemoveAudioTrack" Content="❌ Remove Audio Track" Style="{StaticResource ToolButton}" Click="RemoveAudioTrack_Click" ToolTip="Permanently strip the audio track from the clip"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Preview -->
            <Grid Grid.Column="1" Background="#080812">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="videoContainer" Grid.Row="0" Margin="16">
                    <Border BorderBrush="#2A2A3E" BorderThickness="1" Background="Black" CornerRadius="4">
                        <Grid x:Name="videoStack" ClipToBounds="True">
                            <MediaElement x:Name="videoView" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True" Stretch="Uniform"
                                          MediaOpened="VideoView_MediaOpened"
                                          MediaEnded="VideoView_MediaEnded"/>
                            <Canvas x:Name="overlayCanvas" Background="Transparent"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Playback controls -->
                <Border Grid.Row="1" Background="#161624" Padding="8" CornerRadius="6" Margin="16,0,16,8" BorderBrush="#2A2A3E" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="prevClipBtn" Content="⏮" Width="40" Height="36" Style="{StaticResource ToolButton}" Click="PrevClip_Click" ToolTip="Previous clip"/>
                        <Button x:Name="back5Btn" Content="-5s" Width="48" Height="36" Style="{StaticResource ToolButton}" Click="Back5_Click"/>
                        <Button x:Name="playBtn" Content="▶" Width="56" Height="36" Style="{StaticResource PrimaryButton}" Click="PlayBtn_Click" FontSize="16"/>
                        <Button x:Name="pauseBtn" Content="⏸" Width="48" Height="36" Style="{StaticResource ToolButton}" Click="PauseBtn_Click" FontSize="16"/>
                        <Button x:Name="stopBtn" Content="⏹" Width="48" Height="36" Style="{StaticResource ToolButton}" Click="StopBtn_Click" FontSize="16"/>
                        <Button x:Name="fwd5Btn" Content="+5s" Width="48" Height="36" Style="{StaticResource ToolButton}" Click="Fwd5_Click"/>
                        <Button x:Name="nextClipBtn" Content="⏭" Width="40" Height="36" Style="{StaticResource ToolButton}" Click="NextClip_Click" ToolTip="Next clip"/>
                        <Slider x:Name="volumeSlider" Minimum="0" Maximum="100" Value="80" Width="120" VerticalAlignment="Center" Margin="16,0,0,0" ValueChanged="Volume_Changed"/>
                        <TextBlock Text="🔊" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right Inspector -->
            <Border Grid.Column="2" Background="#161624" BorderBrush="#2A2A3E" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Inspector" Style="{StaticResource HeaderText}"/>

                        <!-- Clip props -->
                        <Border x:Name="clipPanel" Background="#1B1B2A" CornerRadius="6" Padding="10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Selected Clip" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <Label Content="Name"/>
                                <TextBlock x:Name="clipNameText" Foreground="#E6E6F0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                <Label Content="In / Out (seconds)" Margin="0,8,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="clipInBox" TextChanged="ClipInOut_Changed"/>
                                    <TextBox x:Name="clipOutBox" Grid.Column="1" Margin="6,0,0,0" TextChanged="ClipInOut_Changed"/>
                                </Grid>
                                <Label Content="Speed" Margin="0,8,0,0"/>
                                <Slider x:Name="clipSpeedSlider" Minimum="0.25" Maximum="4" Value="1" ValueChanged="ClipSpeed_Changed"/>
                                <TextBlock x:Name="clipSpeedLabel" Foreground="#A0A0B0" Text="1.00x" FontSize="11"/>
                                <Label Content="Volume" Margin="0,4,0,0"/>
                                <Slider x:Name="clipVolSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="ClipVol_Changed"/>
                                <TextBlock x:Name="clipVolLabel" Foreground="#A0A0B0" Text="100%" FontSize="11"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="↻ 90°" Style="{StaticResource ToolButton}" Click="ClipRotate_Click"/>
                                    <Button Grid.Column="1" Content="↺ -90°" Style="{StaticResource ToolButton}" Click="ClipRotateLeft_Click"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="⇄ Flip H" Style="{StaticResource ToolButton}" Click="ClipFlipH_Click"/>
                                    <Button Grid.Column="1" Content="⇅ Flip V" Style="{StaticResource ToolButton}" Click="ClipFlipV_Click"/>
                                </Grid>
                                <Button Content="🗑 Delete Clip" Style="{StaticResource ToolButton}" Click="ClipDelete_Click" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Block props -->
                        <Border x:Name="blockPanel" Background="#1B1B2A" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Selected Block" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <Label Content="Label"/>
                                <TextBox x:Name="lblBox" TextChanged="LblBox_Changed"/>
                                <Label Content="Mode" Margin="0,8,0,0"/>
                                <ComboBox x:Name="modeBox" SelectionChanged="Mode_Changed">
                                    <ComboBoxItem Content="Solid" IsSelected="True"/>
                                    <ComboBoxItem Content="Blur"/>
                                    <ComboBoxItem Content="Pixelate"/>
                                </ComboBox>
                                <Label Content="Color (Solid)" Margin="0,8,0,0"/>
                                <WrapPanel>
                                    <Button Tag="Black" Background="Black" Width="26" Height="26" Margin="2" Click="Color_Click"/>
                                    <Button Tag="White" Background="White" Width="26" Height="26" Margin="2" Click="Color_Click"/>
                                    <Button Tag="Red" Background="Red" Width="26" Height="26" Margin="2" Click="Color_Click"/>
                                    <Button Tag="Green" Background="Green" Width="26" Height="26" Margin="2" Click="Color_Click"/>
                                    <Button Tag="Blue" Background="Blue" Width="26" Height="26" Margin="2" Click="Color_Click"/>
                                    <Button Tag="Yellow" Background="Yellow" Width="26" Height="26" Margin="2" Click="Color_Click"/>
                                </WrapPanel>
                                <Label Content="Blur/Pixel Strength" Margin="0,8,0,0"/>
                                <Slider x:Name="strengthSlider" Minimum="2" Maximum="60" Value="25" ValueChanged="Strength_Changed"/>
                                <CheckBox x:Name="wholeCheck" Content="Cover Whole Timeline" Foreground="White" Margin="0,12,0,0" Checked="Whole_Changed" Unchecked="Whole_Changed"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Start (s)"/>
                                        <TextBox x:Name="startBox" TextChanged="StartEnd_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <Label Content="End (s)"/>
                                        <TextBox x:Name="endBox" TextChanged="StartEnd_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Keyboard Shortcuts Guide -->
                        <Border Background="#1B1B2A" CornerRadius="6" Padding="12" Margin="0,16,0,0" BorderBrush="#2A2A3E" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="⌨" FontSize="16" Foreground="#7C4DFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="Keyboard Shortcuts" FontWeight="Bold" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Playback" Foreground="#7C4DFF" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Space" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Play / Pause" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Splitting" Foreground="#7C4DFF" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="S" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Split at playhead" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Shift+Click" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Split at click position" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                </Grid>

                                <TextBlock Text="Editing" Foreground="#7C4DFF" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+C" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Copy selected" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+V" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Paste copied item" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Backspace" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Delete selected" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Delete" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Delete selected" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Timeline" Foreground="#7C4DFF" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Right-Click" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Clip tools menu" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Drag" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Reorder clips" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Drag edges" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Trim clip / block" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2A2A3E" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Drag file in" Foreground="#E6E6F0" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Insert at green arrow" Foreground="#C0C0D0" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Timeline -->
        <ctl:Timeline x:Name="timeline" Grid.Row="2"/>

        <!-- Status / Progress -->
        <Border Grid.Row="3" Background="#161624" Padding="8,6" BorderBrush="#2A2A3E" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="status" Foreground="#A0A0B0" Text="Ready - Drop video files or click Add Videos" VerticalAlignment="Center"/>
                <ProgressBar x:Name="progress" Grid.Column="1" Height="14" Minimum="0" Maximum="1" Foreground="#7C4DFF" Background="#2A2A3E"/>
            </Grid>
        </Border>
    </Grid>
</Window>
