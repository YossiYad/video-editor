<Window x:Class="VideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VideoEditor.Controls"
        Title="VideoEditor - Pro" Height="900" Width="1440"
        MinHeight="640" MinWidth="1280"
        Icon="icon.ico"
        Background="{DynamicResource Bg0}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Heebo"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="332"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ========================================================
             TOPBAR
             ======================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource TopbarBg}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1">
            <!-- Topbar columns are explicit:
                 - Project meta (Auto, capped via MaxWidth on text)
                 - Transport (Auto, never gets squeezed)
                 - Spacer (*) absorbs slack
                 - Status + right actions (Auto)
                 ScrollViewer keeps everything reachable on narrow screens: the topbar never
                 hides items behind their neighbours, and a horizontal scrollbar appears only
                 if the user shrinks the window beyond what the controls need. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid Margin="14,0" MinWidth="1380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Open + project meta -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="openBtn" Style="{DynamicResource GhostButton}" Click="OpenBtn_Click" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" Open" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Width="1" Height="28" Margin="10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="projectName" Text="video_editor_project" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock x:Name="projDims" Text="1920×1080" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextDim}"/>
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource TextDim}" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="projFps" Text="30 fps" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextDim}"/>
                            <Button x:Name="changeFormatBtn" Style="{DynamicResource GhostButton}"
                                    Padding="6,1" Margin="8,0,0,0" Click="ChangeFormat_Click"
                                    ToolTip="Change project format">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="projTargetChip" Text="→ 1920×1080" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource AccentHover}"/>
                                    <TextBlock Text=" ▾" FontSize="9" Foreground="{DynamicResource TextMute}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Transport (in its own Auto column so it can't be squeezed). -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="prevClipBtn" Content="⏮" Width="28" Height="32" Style="{DynamicResource GhostButton}" Click="PrevClip_Click" FontSize="13" Padding="0" ToolTip="Previous clip"/>
                    <Button x:Name="back5Btn" Content="-5s" Width="32" Height="32" Style="{DynamicResource GhostButton}" Click="Back5_Click" FontSize="11" Padding="0" ToolTip="Back 5s (Shift+← for ±1s)"/>
                    <Button x:Name="playBtn" Content="▶" Width="42" Height="36" Style="{DynamicResource PrimaryButton}" Click="PlayBtn_Click" FontSize="16" Margin="3,0" ToolTip="Play (Space)"/>
                    <Button x:Name="pauseBtn" Width="28" Height="32" Style="{DynamicResource GhostButton}" Click="PauseBtn_Click" Padding="0" ToolTip="Pause (Space)">
                        <!-- Pure-shape pause icon: two parallel bars. Avoids the ⏸ unicode glyph
                             which Windows sometimes renders as a coloured emoji or weird square. -->
                        <Grid Width="10" Height="13">
                            <Rectangle Width="3" Height="13" Fill="{DynamicResource Text}" HorizontalAlignment="Left"/>
                            <Rectangle Width="3" Height="13" Fill="{DynamicResource Text}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Button>
                    <Button x:Name="stopBtn" Content="■" Width="28" Height="32" Style="{DynamicResource GhostButton}" Click="StopBtn_Click" FontSize="11" Padding="0" ToolTip="Stop"/>
                    <Button x:Name="fwd5Btn" Content="+5s" Width="32" Height="32" Style="{DynamicResource GhostButton}" Click="Fwd5_Click" FontSize="11" Padding="0" ToolTip="Forward 5s"/>
                    <Button x:Name="nextClipBtn" Content="⏭" Width="28" Height="32" Style="{DynamicResource GhostButton}" Click="NextClip_Click" FontSize="13" Padding="0" ToolTip="Next clip"/>

                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="curTimeText" Text="00:00.000" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Text}"/>
                            <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource TextDim}" Margin="4,0"/>
                            <TextBlock x:Name="totTimeText" Text="00:00.000" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextMute}"/>
                        </StackPanel>
                    </Border>

                    <!-- Volume tile: wider track + clickable empty-track area + visible thumb at all values. -->
                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="6,0,0,0" MinWidth="160">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔊" FontSize="13" Foreground="{DynamicResource TextMute}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="volumeSlider" Minimum="0" Maximum="100" Value="80" Width="96" Height="20" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="Volume_Changed"/>
                            <TextBlock x:Name="volText" Text="80" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}" Width="24" TextAlignment="Right" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Spacer column absorbs slack between transport and right-side actions. -->
                <Grid Grid.Column="2"/>

                <!-- Status + actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Height="32" Margin="0,0,12,0"/>
                    <Grid Width="220" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" x:Name="statusDot" Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#4CAF50" BlurRadius="6" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Grid.Column="1" x:Name="status" Text="Ready · drop video files to add" FontSize="11.5" Foreground="{DynamicResource TextMute}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Height="14">
                                <ProgressBar x:Name="progress" Minimum="0" Maximum="1" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <!-- "45 %" text overlaid on the bar so progress is readable even when the bar
                                 colour blends into the gradient on certain themes. Hidden until the first
                                 progress.Report (set by the code-behind when an export starts). -->
                            <TextBlock x:Name="progressLabel" Text=""
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBright}" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                    <Button x:Name="settingsBtn" Style="{DynamicResource IconButton}" Click="Settings_Click" ToolTip="Settings  ·  ,">
                        <!-- Settings glyph from Segoe MDL2 Assets - a real gear icon, not the
                             ⚙ (U+2699) codepoint that Windows can render as a colourful flower. -->
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Text}"/>
                    </Button>

                    <Grid Width="36" Height="36" Margin="6,0">
                        <Button x:Name="helpBtn" Style="{DynamicResource IconButton}" Click="Help_Click" ToolTip="User Guide  ·  ?  /  F1">
                            <TextBlock Text="?" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                        </Button>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#8B5CFF" BlurRadius="6" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <Button x:Name="saveBtn" Style="{DynamicResource SuccessButton}" Click="SaveBtn_Click" Height="36" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- ========================================================
             WORKSPACE (sidebar / preview / inspector)
             ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="312"/>
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <Border Grid.Column="0" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand -->
                    <Border DockPanel.Dock="Top" Height="48" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <Border Width="28" Height="28" CornerRadius="7" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A07CFF" Offset="0"/>
                                        <GradientStop Color="#5B3AD9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="▶" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="VideoEditor" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="v 1.4 · FFmpeg backend" FontSize="10" Foreground="{DynamicResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stats card -->
                    <Border DockPanel.Dock="Top" Margin="10,8" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="statClips" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                                <TextBlock Text="CLIPS" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Height="22" Fill="{DynamicResource Line}"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="statBlocks" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                                <TextBlock Text="BLOCKS" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Height="22" Fill="{DynamicResource Line}"/>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="●" Foreground="{DynamicResource Success}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="FFMPEG" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBlock Text="●" Foreground="{DynamicResource Success}" FontSize="10"/>
                                <TextBlock Text=" FFmpeg 6.1" FontSize="10.5" Foreground="{DynamicResource TextMute}" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="ready" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextDim}"/>
                        </Grid>
                    </Border>

                    <!-- Tool groups -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,0">
                        <StackPanel Margin="0,0,0,10">

                            <!-- Workspace -->
                            <TextBlock Text="WORKSPACE" Style="{DynamicResource GroupLabel}"/>
                            <Button Style="{DynamicResource SidebarToolButton}" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource Text}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentDark}" BorderThickness="1">
                                        <TextBlock Text="✎" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Video Editor" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="⌘E" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource TextDim}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Capture -->
                            <TextBlock Text="CAPTURE" Style="{DynamicResource GroupLabel}"/>
                            <Button x:Name="btnDownloadUrl" Style="{DynamicResource SidebarToolButton}" Click="DownloadUrl_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentDark}" BorderThickness="1">
                                        <TextBlock Text="🌐" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Import from URL" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <Border Background="#338B5CFF" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="NEW" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentHover}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnScreenRec" Style="{DynamicResource SidebarToolButton}" Click="ScreenRec_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🖥" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Screen Recorder" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTts" Style="{DynamicResource SidebarToolButton}" Click="Tts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🎙" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Text to Speech" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnRecord" Style="{DynamicResource SidebarToolButton}" Click="Record_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🎥" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Camera Recorder" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnMerge" Style="{DynamicResource SidebarToolButton}" Click="Merge_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔗" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Merge Videos" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Overlays -->
                            <TextBlock Text="OVERLAYS" Style="{DynamicResource GroupLabel}"/>
                            <Button x:Name="addBlockOverlayBtn" Style="{DynamicResource SidebarToolButton}" Click="AddBlock_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource ClipPurple}" BorderBrush="{DynamicResource AccentDark}" BorderThickness="1">
                                        <TextBlock Text="■" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Add Hide Block" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="B" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource TextDim}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnRemoveLogo" Style="{DynamicResource SidebarToolButton}" Click="RemoveLogo_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🚫" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Remove Logo" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnAddImage" Style="{DynamicResource SidebarToolButton}" Click="AddImage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🖼" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Add Image" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnAddText" Style="{DynamicResource SidebarToolButton}" Click="AddText_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔤" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Add Text" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Audio -->
                            <TextBlock Text="AUDIO" Style="{DynamicResource GroupLabel}"/>
                            <Button x:Name="btnAiCaptions" Style="{DynamicResource SidebarToolButton}" Click="AiCaptions_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="✨" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AI Captions" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnAddAudio" Style="{DynamicResource SidebarToolButton}" Click="AddAudio_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🎵" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Add Audio" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnVolume" Style="{DynamicResource SidebarToolButton}" Click="Volume_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔊" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Change Volume" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnExtractAudio" Style="{DynamicResource SidebarToolButton}" Click="ExtractAudio_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="↗" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Extract Audio" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnMuteAudio" Style="{DynamicResource SidebarToolButton}" Click="MuteAudio_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔇" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Mute / Remove Audio" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Hide blocks -->
                            <TextBlock Text="HIDE BLOCKS" Style="{DynamicResource GroupLabel}"/>
                            <Button x:Name="addBlockBtn" Style="{DynamicResource SidebarToolButton}" Click="AddBlock_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource ClipPurple}" BorderBrush="{DynamicResource AccentDark}" BorderThickness="1">
                                        <TextBlock Text="◼" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Add Hide Block" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="B" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource TextDim}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="deleteBlockBtn" Style="{DynamicResource SidebarToolButton}" Click="DeleteBlock_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="🗑" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Delete Block" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Split -->
                            <TextBlock Text="SPLIT" Style="{DynamicResource GroupLabel}"/>
                            <Button x:Name="splitBtn" Style="{DynamicResource SidebarToolButton}" Click="Split_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="✂" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Split at Playhead" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="S" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource TextDim}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="splitNBtn" Style="{DynamicResource SidebarToolButton}" Click="SplitN_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <TextBlock Text="⋯" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Split into N Parts…" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ CENTER PREVIEW ============ -->
            <Grid Grid.Column="1" Background="{DynamicResource PreviewWrapBg}">
                <Grid Margin="20,18,20,16" x:Name="videoContainerOuter" SizeChanged="VideoContainerOuter_SizeChanged">
                    <Grid x:Name="videoContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Background="Black" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <Grid x:Name="videoStack" ClipToBounds="True">
                            <MediaElement x:Name="videoView" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True" Stretch="Uniform"
                                          MediaOpened="VideoView_MediaOpened"
                                          MediaEnded="VideoView_MediaEnded"
                                          MediaFailed="VideoView_MediaFailed"/>
                            <Canvas x:Name="overlayCanvas" Background="Transparent"/>
                            <!-- Resize handles for the per-clip canvas transform.
                                 Pinned to the 4 corners of the project canvas via alignment so
                                 they always render at the visible bounds - no measuring math.
                                 Hidden when no video clip is loaded. -->
                            <!-- No Background on this Grid: a transparent Background still hit-tests
                                 the whole layer, which used to swallow clicks meant for the
                                 hide-block ResizableBlock controls underneath. With Background
                                 unset only the dashed border + the 4 corner handles are clickable;
                                 everything else (clicks meant for blocks, the videoView pan, etc.)
                                 passes through to the layer underneath. -->
                            <Grid x:Name="canvasHandlesLayer" IsHitTestVisible="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed">
                                <!-- Dashed purple frame around the (visible) project canvas. -->
                                <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                        IsHitTestVisible="False" Margin="2"/>
                                <Border x:Name="canvasHandleTL" Width="20" Height="20"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="White" BorderBrush="{DynamicResource Accent}" BorderThickness="3"
                                        CornerRadius="4" Cursor="SizeNWSE"
                                        MouseLeftButtonDown="CanvasHandle_MouseDown"
                                        MouseMove="CanvasHandle_MouseMove"
                                        MouseLeftButtonUp="CanvasHandle_MouseUp"
                                        Tag="tl"/>
                                <Border x:Name="canvasHandleTR" Width="20" Height="20"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="White" BorderBrush="{DynamicResource Accent}" BorderThickness="3"
                                        CornerRadius="4" Cursor="SizeNESW"
                                        MouseLeftButtonDown="CanvasHandle_MouseDown"
                                        MouseMove="CanvasHandle_MouseMove"
                                        MouseLeftButtonUp="CanvasHandle_MouseUp"
                                        Tag="tr"/>
                                <Border x:Name="canvasHandleBL" Width="20" Height="20"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Background="White" BorderBrush="{DynamicResource Accent}" BorderThickness="3"
                                        CornerRadius="4" Cursor="SizeNESW"
                                        MouseLeftButtonDown="CanvasHandle_MouseDown"
                                        MouseMove="CanvasHandle_MouseMove"
                                        MouseLeftButtonUp="CanvasHandle_MouseUp"
                                        Tag="bl"/>
                                <Border x:Name="canvasHandleBR" Width="20" Height="20"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="White" BorderBrush="{DynamicResource Accent}" BorderThickness="3"
                                        CornerRadius="4" Cursor="SizeNWSE"
                                        MouseLeftButtonDown="CanvasHandle_MouseDown"
                                        MouseMove="CanvasHandle_MouseMove"
                                        MouseLeftButtonUp="CanvasHandle_MouseUp"
                                        Tag="br"/>
                            </Grid>

                            <!-- HUD strip -->
                            <Border VerticalAlignment="Bottom" Background="#CC0A0C12" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Ellipse x:Name="hudDot" Width="8" Height="8" Fill="{DynamicResource Warn}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD43B" BlurRadius="6" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock x:Name="hudClipName" Text="No clip loaded" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="hudTimeWithin" Text="--:--" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextMute}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                                        <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                            <TextBlock x:Name="hudBlocks" Text="0 blocks" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                    <Border x:Name="emptyStartPanel"
                            Background="#E60F121B"
                            BorderBrush="{DynamicResource LineStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Width="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Start a project" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pick the source you want to work from." FontSize="12" Foreground="{DynamicResource TextMute}" HorizontalAlignment="Center" Margin="0,5,0,16"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Button Content="Open Files" Style="{DynamicResource PrimaryButton}" Click="OpenBtn_Click" Height="38" Margin="0,0,6,6"/>
                                <Button Content="Import URL" Style="{DynamicResource ToolButton}" Click="DownloadUrl_Click" Height="38" Margin="6,0,0,6"/>
                                <Button Content="Screen Record" Style="{DynamicResource ToolButton}" Click="ScreenRec_Click" Height="38" Margin="0,6,6,0"/>
                                <Button Content="Camera Record" Style="{DynamicResource ToolButton}" Click="Record_Click" Height="38" Margin="6,6,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="screenRecorderPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource Bg1}"
                            BorderBrush="{DynamicResource LineStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="inlineRecorderDot" Width="9" Height="9" Fill="{DynamicResource TextDim}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="inlineRecorderTitle" Text="Screen Recorder" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="inlineRecorderStatus" Text="" FontSize="11.5" Foreground="{DynamicResource TextMute}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="closeInlineRecorderBtn" Content="Close" Style="{DynamicResource ToolButtonSmall}" Click="CloseInlineRecorder_Click" Height="28" Padding="12,0"/>
                            </Grid>

                            <Border Grid.Row="1" Background="Black" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Cursor="Hand">
                                <Grid Background="Transparent" MouseLeftButtonDown="RecorderPreview_Clicked">
                                    <Image x:Name="inlineRecorderPreviewImage" Stretch="Uniform"/>
                                    <Canvas x:Name="inlineRecorderOverlayCanvas" Background="Transparent"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <TextBlock x:Name="inlineRecorderDiagText"
                                           Text=""
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextDim}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                                <TextBox x:Name="inlineRecorderLogText"
                                         Visibility="Collapsed"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="10"
                                         Foreground="{DynamicResource TextDim}"
                                         Background="{DynamicResource Bg0}"
                                         BorderBrush="{DynamicResource Line}"
                                         BorderThickness="1"
                                         Margin="0,36,0,0"
                                         MinHeight="72"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>

            <!-- ============ INSPECTOR ============ -->
            <Border x:Name="inspectorBorder" Grid.Column="2" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Tabs -->
                    <Border x:Name="inspectorTabsBar" DockPanel.Dock="Top" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,10,10,8" Visibility="Collapsed">
                        <Grid>
                            <Grid x:Name="normalTabsBar" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="tabBlockBtn" Grid.Column="0" Visibility="Collapsed" Style="{DynamicResource InspectorTab}" GroupName="InspectorTabs" Click="TabBlock_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◼" FontSize="11"/>
                                        <TextBlock Text="Block" Margin="6,0,0,0"/>
                                        <Ellipse x:Name="tabBlockDot" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="5,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="tabClipBtn" Grid.Column="1" Visibility="Collapsed" Style="{DynamicResource InspectorTab}" GroupName="InspectorTabs" Click="TabClip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" FontSize="11"/>
                                        <TextBlock Text="Clip" Margin="6,0,0,0"/>
                                        <Ellipse x:Name="tabClipDot" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="5,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="tabExportBtn" Grid.Column="2" Visibility="Collapsed" Style="{DynamicResource InspectorTab}" GroupName="InspectorTabs" Click="TabExport_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" FontSize="11"/>
                                        <TextBlock Text="Export" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                            <ItemsControl x:Name="recorderTabHost" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <RadioButton x:Name="tabTtsBtn" Visibility="Collapsed" Style="{DynamicResource InspectorTab}" GroupName="InspectorTabs" Click="TabTts_Click" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🎙" FontSize="11"/>
                                    <TextBlock Text="Text to Speech" Margin="6,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,18">

                            <!-- =========== CLIP PANEL =========== -->
                            <Border x:Name="clipPanel" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Clip header -->
                                    <StackPanel Orientation="Horizontal" Margin="16,12,16,14">
                                        <Border x:Name="clipAccentTile" Width="32" Height="32" CornerRadius="8" Background="#338B5CFF" BorderBrush="#558B5CFF" BorderThickness="1">
                                            <TextBlock Text="▤" FontSize="14" Foreground="{DynamicResource AccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="clipNameText" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                            <TextBlock x:Name="clipMetaText" Text="-" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,2,0,0" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Trim -->
                                    <StackPanel Margin="16,4,16,12">
                                        <TextBlock Text="TRIM - IN / OUT" Style="{DynamicResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="clipInBox" TextChanged="ClipInOut_Changed"/>
                                            <TextBox x:Name="clipOutBox" Grid.Column="1" Margin="6,0,0,0" TextChanged="ClipInOut_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="0.000" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock x:Name="clipEffText" Grid.Column="1" Text="Effective: 00:00.000" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextMute}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="clipDurText" Grid.Column="2" Text="0.00" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,0"/>

                                    <!-- Speed / volume -->
                                    <StackPanel Margin="16,12,16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SPEED" Style="{DynamicResource FieldLabel}" Grid.Column="0"/>
                                            <TextBlock x:Name="clipSpeedLabel" Text="1.00×" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource Text}" Grid.Column="1"/>
                                        </Grid>
                                        <Slider x:Name="clipSpeedSlider" Minimum="0.25" Maximum="4" Value="1" ValueChanged="ClipSpeed_Changed"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="0.25×" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock Text="1.00×" Grid.Column="1" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="4.00×" Grid.Column="2" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="VOLUME" Style="{DynamicResource FieldLabel}" Grid.Column="0"/>
                                            <TextBlock x:Name="clipVolLabel" Text="100%" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource Text}" Grid.Column="1"/>
                                        </Grid>
                                        <Slider x:Name="clipVolSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="ClipVol_Changed"/>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,0"/>

                                    <!-- Transform actions -->
                                    <StackPanel Margin="16,12,16,12">
                                        <TextBlock Text="TRANSFORM" Style="{DynamicResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Content="↺ 90° L" Style="{DynamicResource ToolButtonSmall}" Click="ClipRotateLeft_Click"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="↻ 90° R" Style="{DynamicResource ToolButtonSmall}" Click="ClipRotate_Click"/>
                                            <Button Grid.Row="1" Grid.Column="0" Content="⇄ Flip H" Style="{DynamicResource ToolButtonSmall}" Click="ClipFlipH_Click"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="⇅ Flip V" Style="{DynamicResource ToolButtonSmall}" Click="ClipFlipV_Click"/>
                                            <Button Grid.Row="2" Grid.Column="0" Content="🔁 Loop" Style="{DynamicResource ToolButtonSmall}" Click="Loop_Click"/>
                                            <Button Grid.Row="2" Grid.Column="1" Content="🤚 Stabilize" Style="{DynamicResource ToolButtonSmall}" Click="Stabilize_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,0"/>

                                    <!-- Canvas (per-clip scale + position on the project format) -->
                                    <StackPanel Margin="16,12,16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="CANVAS" Style="{DynamicResource FieldLabel}"/>
                                            <Button Grid.Column="1" x:Name="canvasResetBtn" Content="Reset" Padding="8,2"
                                                    Style="{DynamicResource GhostButton}" FontSize="10.5"
                                                    Click="CanvasReset_Click" ToolTip="Reset zoom &amp; position (double-click on the preview)"/>
                                        </Grid>
                                        <TextBlock Text="Drag preview to move · scroll to zoom · double-click to reset"
                                                   FontSize="10.5" Foreground="{DynamicResource TextDim}"
                                                   TextWrapping="Wrap" Margin="0,2,0,8"/>

                                        <TextBlock Text="Zoom" FontSize="10.5" Foreground="{DynamicResource TextMute}" Margin="0,0,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" x:Name="canvasScaleSlider" Minimum="0.1" Maximum="4.0" Value="1.0"
                                                    SmallChange="0.05" LargeChange="0.2" IsMoveToPointEnabled="True"
                                                    ValueChanged="CanvasScale_Changed"/>
                                            <TextBlock Grid.Column="1" x:Name="canvasScaleText" Text="100%"
                                                       FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}"
                                                       VerticalAlignment="Center" TextAlignment="Right"/>
                                        </Grid>

                                        <TextBlock Text="Offset X" FontSize="10.5" Foreground="{DynamicResource TextMute}" Margin="0,6,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" x:Name="canvasOffsetXSlider" Minimum="-1" Maximum="1" Value="0"
                                                    SmallChange="0.02" LargeChange="0.1" IsMoveToPointEnabled="True"
                                                    ValueChanged="CanvasOffsetX_Changed"/>
                                            <TextBlock Grid.Column="1" x:Name="canvasOffsetXText" Text="0%"
                                                       FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}"
                                                       VerticalAlignment="Center" TextAlignment="Right"/>
                                        </Grid>

                                        <TextBlock Text="Offset Y" FontSize="10.5" Foreground="{DynamicResource TextMute}" Margin="0,6,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" x:Name="canvasOffsetYSlider" Minimum="-1" Maximum="1" Value="0"
                                                    SmallChange="0.02" LargeChange="0.1" IsMoveToPointEnabled="True"
                                                    ValueChanged="CanvasOffsetY_Changed"/>
                                            <TextBlock Grid.Column="1" x:Name="canvasOffsetYText" Text="0%"
                                                       FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}"
                                                       VerticalAlignment="Center" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,0"/>

                                    <!-- Export-time effects -->
                                    <StackPanel Margin="16,12,16,12">
                                        <TextBlock Text="EXPORT-TIME EFFECTS" Style="{DynamicResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Content="◳ Crop" Style="{DynamicResource ToolButtonSmall}" Click="Crop_Click"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="🚫 Remove Logo" Style="{DynamicResource ToolButtonSmall}" Click="RemoveLogo_Click"/>
                                            <Button Grid.Row="1" Grid.Column="0" Content="🔤 Add Text" Style="{DynamicResource ToolButtonSmall}" Click="AddText_Click"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="🖼 Add Image" Style="{DynamicResource ToolButtonSmall}" Click="AddImage_Click"/>
                                            <Button Grid.Row="2" Grid.Column="0" Content="🎵 Add Audio" Style="{DynamicResource ToolButtonSmall}" Click="AddAudio_Click"/>
                                            <Button Grid.Row="2" Grid.Column="1" Content="⛶ Resize" Style="{DynamicResource ToolButtonSmall}" Click="Resize_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,0"/>

                                    <!-- Arrange -->
                                    <StackPanel Margin="16,12,16,12">
                                        <TextBlock Text="ARRANGE" Style="{DynamicResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Content="✂ Split" Style="{DynamicResource ToolButtonSmall}" Click="Split_Click"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="⋯ Split N" Style="{DynamicResource ToolButtonSmall}" Click="SplitN_Click"/>
                                            <Button Grid.Row="1" Grid.Column="0" Content="⧉ Duplicate" Style="{DynamicResource ToolButtonSmall}" Click="DuplicateClip_Click"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="🗑 Delete" Style="{DynamicResource DangerButton}" Click="ClipDelete_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- =========== BLOCK PANEL =========== -->
                            <Border x:Name="blockPanel" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Block header -->
                                    <StackPanel Orientation="Horizontal" Margin="16,12,16,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="#338B5CFF" BorderBrush="#558B5CFF" BorderThickness="1">
                                            <TextBlock Text="◼" FontSize="14" Foreground="{DynamicResource AccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hide Block" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="13.5"/>
                                            <TextBlock Text="Renders over video at export" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Label -->
                                    <StackPanel Margin="16,4,16,10">
                                        <TextBlock Text="LABEL" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="lblBox" TextChanged="LblBox_Changed"/>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,0"/>

                                    <!-- Mode -->
                                    <StackPanel Margin="16,12,16,4">
                                        <TextBlock Text="MODE" Style="{DynamicResource FieldLabel}"/>
                                        <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton x:Name="modeSolidBtn" Grid.Column="0" Style="{DynamicResource SegmentButton}" GroupName="BlockMode" IsChecked="True" Click="ModeSolid_Click" Content="Solid"/>
                                                <RadioButton x:Name="modeBlurBtn" Grid.Column="1" Style="{DynamicResource SegmentButton}" GroupName="BlockMode" Click="ModeBlur_Click" Content="Blur"/>
                                                <RadioButton x:Name="modePixelBtn" Grid.Column="2" Style="{DynamicResource SegmentButton}" GroupName="BlockMode" Click="ModePixel_Click" Content="Pixelate"/>
                                            </Grid>
                                        </Border>
                                        <!-- Hidden ComboBox kept for code-behind compatibility -->
                                        <ComboBox x:Name="modeBox" Visibility="Collapsed" SelectionChanged="Mode_Changed">
                                            <ComboBoxItem Content="Solid" IsSelected="True"/>
                                            <ComboBoxItem Content="Blur"/>
                                            <ComboBoxItem Content="Pixelate"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Color swatches (Solid) -->
                                    <StackPanel x:Name="colorRow" Margin="16,8,16,4">
                                        <TextBlock Text="COLOR" Style="{DynamicResource FieldLabel}"/>
                                        <WrapPanel>
                                            <Button Tag="Black"  Background="Black"   Width="22" Height="22" Margin="0,0,6,0" Style="{DynamicResource ToolButtonSmall}" Click="Color_Click" Padding="0"/>
                                            <Button Tag="White"  Background="White"   Width="22" Height="22" Margin="0,0,6,0" Style="{DynamicResource ToolButtonSmall}" Click="Color_Click" Padding="0"/>
                                            <Button Tag="#FF6B6B" Background="#FF6B6B" Width="22" Height="22" Margin="0,0,6,0" Style="{DynamicResource ToolButtonSmall}" Click="Color_Click" Padding="0"/>
                                            <Button Tag="#7C4DFF" Background="#7C4DFF" Width="22" Height="22" Margin="0,0,6,0" Style="{DynamicResource ToolButtonSmall}" Click="Color_Click" Padding="0"/>
                                            <Button Tag="#00B8D9" Background="#00B8D9" Width="22" Height="22" Margin="0,0,6,0" Style="{DynamicResource ToolButtonSmall}" Click="Color_Click" Padding="0"/>
                                            <Button Tag="#FFD43B" Background="#FFD43B" Width="22" Height="22" Margin="0,0,6,0" Style="{DynamicResource ToolButtonSmall}" Click="Color_Click" Padding="0"/>
                                            <Button Tag="#51CF66" Background="#51CF66" Width="22" Height="22" Margin="0,0,6,0" Style="{DynamicResource ToolButtonSmall}" Click="Color_Click" Padding="0"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Strength (Blur/Pixel) -->
                                    <StackPanel x:Name="strengthRow" Margin="16,8,16,4" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="STRENGTH" Style="{DynamicResource FieldLabel}" Grid.Column="0"/>
                                            <TextBlock x:Name="strengthLabel" Text="25" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource Text}" Grid.Column="1"/>
                                        </Grid>
                                        <Slider x:Name="strengthSlider" Minimum="2" Maximum="60" Value="25" ValueChanged="Strength_Changed"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Subtle" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock Text="Soft" Grid.Column="1" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Heavy" Grid.Column="2" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,10,16,0"/>

                                    <!-- Whole video toggle + start/end -->
                                    <StackPanel Margin="16,12,16,12">
                                        <CheckBox x:Name="wholeCheck" Content="Cover whole timeline" Foreground="{DynamicResource Text}" Checked="Whole_Changed" Unchecked="Whole_Changed"/>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="START" Style="{DynamicResource FieldLabel}"/>
                                            <Grid FlowDirection="LeftToRight">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" x:Name="startH" TextChanged="StartEnd_Changed" TextAlignment="Center" ToolTip="hours"/>
                                                <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="3,0" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBox Grid.Column="2" x:Name="startM" TextChanged="StartEnd_Changed" TextAlignment="Center" ToolTip="minutes"/>
                                                <TextBlock Grid.Column="3" Text=":" VerticalAlignment="Center" Margin="3,0" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBox Grid.Column="4" x:Name="startS" TextChanged="StartEnd_Changed" TextAlignment="Center" ToolTip="seconds"/>
                                                <TextBlock Grid.Column="5" Text="." VerticalAlignment="Center" Margin="3,0" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBox Grid.Column="6" x:Name="startMs" TextChanged="StartEnd_Changed" TextAlignment="Center" ToolTip="milliseconds (0–999)"/>
                                            </Grid>
                                            <Grid FlowDirection="LeftToRight" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="h" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Margin="3,0"/>
                                                <TextBlock Grid.Column="2" Text="m" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Margin="3,0"/>
                                                <TextBlock Grid.Column="4" Text="s" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Margin="3,0"/>
                                                <TextBlock Grid.Column="6" Text="ms" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="END" Style="{DynamicResource FieldLabel}"/>
                                            <Grid FlowDirection="LeftToRight">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" x:Name="endH" TextChanged="StartEnd_Changed" TextAlignment="Center" ToolTip="hours"/>
                                                <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="3,0" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBox Grid.Column="2" x:Name="endM" TextChanged="StartEnd_Changed" TextAlignment="Center" ToolTip="minutes"/>
                                                <TextBlock Grid.Column="3" Text=":" VerticalAlignment="Center" Margin="3,0" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBox Grid.Column="4" x:Name="endS" TextChanged="StartEnd_Changed" TextAlignment="Center" ToolTip="seconds"/>
                                                <TextBlock Grid.Column="5" Text="." VerticalAlignment="Center" Margin="3,0" Foreground="{DynamicResource TextDim}" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBox Grid.Column="6" x:Name="endMs" TextChanged="StartEnd_Changed" TextAlignment="Center" ToolTip="milliseconds (0–999)"/>
                                            </Grid>
                                            <Grid FlowDirection="LeftToRight" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="h" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Margin="3,0"/>
                                                <TextBlock Grid.Column="2" Text="m" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Margin="3,0"/>
                                                <TextBlock Grid.Column="4" Text="s" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Margin="3,0"/>
                                                <TextBlock Grid.Column="6" Text="ms" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,0"/>

                                    <!-- Block actions -->
                                    <StackPanel Margin="16,12,16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="⧉ Duplicate" Style="{DynamicResource ToolButtonSmall}" Click="DuplicateBlock_Click"/>
                                            <Button Grid.Column="1" Content="🗑 Delete" Style="{DynamicResource DangerButton}" Click="DeleteBlock_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- =========== MULTI-SELECT PANEL =========== -->
                            <Border x:Name="multiSelectInspector" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" Margin="16,28,16,18">
                                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="6" Opacity="0.5"/>
                                        </Border.Effect>
                                        <TextBlock Text="◫◫" FontSize="20" Foreground="{DynamicResource AccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="multiSelectCountText" Text="0 items selected" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Delete removes all. Drag any one to move them together." Foreground="{DynamicResource TextMute}" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- =========== PROJECT / EXPORT PANEL =========== -->
                            <Border x:Name="emptyInspector" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Hero -->
                                    <StackPanel HorizontalAlignment="Center" Margin="16,18,16,4">
                                        <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="6" Opacity="0.5"/>
                                            </Border.Effect>
                                            <TextBlock Text="💾" FontSize="22" Foreground="{DynamicResource AccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Output settings" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Select a clip or block to edit it." Foreground="{DynamicResource TextMute}" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,14,16,0"/>

                                    <!-- Format -->
                                    <StackPanel Margin="16,12,16,4">
                                        <TextBlock Text="FORMAT" Style="{DynamicResource FieldLabel}"/>
                                        <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton x:Name="fmtMp4Btn" Grid.Column="0" Style="{DynamicResource SegmentButton}" GroupName="ExportFmt" IsChecked="True" Content="MP4 H.264"/>
                                                <RadioButton x:Name="fmtMovBtn" Grid.Column="1" Style="{DynamicResource SegmentButton}" GroupName="ExportFmt" Content="MOV"/>
                                                <RadioButton x:Name="fmtMkvBtn" Grid.Column="2" Style="{DynamicResource SegmentButton}" GroupName="ExportFmt" Content="MKV"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Project format (click chip to open picker) / FPS -->
                                    <Grid Margin="16,10,16,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="PROJECT FORMAT" Style="{DynamicResource FieldLabel}"/>
                                            <Button x:Name="inspectorFormatBtn" Click="ChangeFormat_Click"
                                                    Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}"
                                                    BorderThickness="1" Cursor="Hand" Height="28"
                                                    HorizontalContentAlignment="Stretch" Padding="9,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="inspectorFormatText" Grid.Column="0"
                                                               Text="Source" FontFamily="Consolas" FontSize="11.5"
                                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                                               TextAlignment="Left"/>
                                                    <TextBlock Grid.Column="1" Text="▾" FontSize="9"
                                                               Foreground="{DynamicResource TextMute}" VerticalAlignment="Center"
                                                               Margin="6,0,0,0"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="FPS" Style="{DynamicResource FieldLabel}"/>
                                            <ComboBox x:Name="exportFpsBox">
                                                <ComboBoxItem Content="24"/>
                                                <ComboBoxItem Content="25"/>
                                                <ComboBoxItem Content="30" IsSelected="True"/>
                                                <ComboBoxItem Content="50"/>
                                                <ComboBoxItem Content="60"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fit mode -->
                                    <StackPanel Margin="16,10,16,4">
                                        <TextBlock Text="FIT" Style="{DynamicResource FieldLabel}"/>
                                        <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton x:Name="fitContainBtn" Grid.Column="0" Style="{DynamicResource SegmentButton}"
                                                             GroupName="FitMode" IsChecked="True" Content="Contain"
                                                             Tag="contain" Checked="FitMode_Checked"/>
                                                <RadioButton x:Name="fitCoverBtn"   Grid.Column="1" Style="{DynamicResource SegmentButton}"
                                                             GroupName="FitMode" Content="Cover"
                                                             Tag="cover" Checked="FitMode_Checked"/>
                                                <RadioButton x:Name="fitBlurBtn"    Grid.Column="2" Style="{DynamicResource SegmentButton}"
                                                             GroupName="FitMode" Content="Blur bg"
                                                             Tag="blur" Checked="FitMode_Checked"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="fitPreviewHint" Margin="0,4,0,0"
                                                   Text="Preview shows the target canvas. Cover/Blur effects render on export."
                                                   Foreground="{DynamicResource TextDim}" FontSize="10.5"
                                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- CRF -->
                                    <StackPanel Margin="16,12,16,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="QUALITY (CRF)" Style="{DynamicResource FieldLabel}" Grid.Column="0"/>
                                            <TextBlock x:Name="exportCrfLabel" Text="20" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource Text}" Grid.Column="1"/>
                                        </Grid>
                                        <Slider x:Name="exportCrfSlider" Minimum="14" Maximum="30" Value="20" ValueChanged="ExportCrf_Changed"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Visually lossless" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock Text="Smaller file" Grid.Column="1" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="16,12,16,0"/>

                                    <!-- Meta cards -->
                                    <Grid Margin="16,12,16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="0,0,4,4">
                                            <StackPanel>
                                                <TextBlock Text="PROJECT DURATION" FontSize="9.5" Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock x:Name="metaDuration" Text="00:00.000" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="4,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="CLIPS" FontSize="9.5" Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock x:Name="metaClips" Text="0" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="0,4,4,0">
                                            <StackPanel>
                                                <TextBlock Text="CODEC" FontSize="9.5" Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock Text="H.264 / AAC" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="4,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="HIDE BLOCKS" FontSize="9.5" Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock x:Name="metaBlocks" Text="0" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- CTA buttons -->
                                    <StackPanel Margin="16,4,16,4">
                                        <Button Content="💾 Export project" Style="{DynamicResource SuccessButton}" Click="SaveBtn_Click" Height="36" HorizontalContentAlignment="Center"/>
                                        <Button Content="↗ Extract project audio only" Style="{DynamicResource ToolButtonSmall}" Click="ExtractAudioProject_Click" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- =========== SCREEN RECORDER PANEL =========== -->
                            <Border x:Name="recorderInspectorPanel" Visibility="Collapsed">
                                <StackPanel Margin="14,12,14,14">
                                    <StackPanel x:Name="inlineRecorderSourcePanel">
                                        <TextBlock Text="RECORDING SOURCE" Style="{DynamicResource FieldLabel}"/>
                                        <ComboBox x:Name="inlineRecorderSourceBox" SelectionChanged="InlineRecorderSource_Changed" Margin="0,0,0,10"/>
                                    </StackPanel>

                                    <StackPanel x:Name="inlineRecorderCameraPanel" Visibility="Collapsed">
                                        <TextBlock x:Name="inlineCameraBgLabel" Text="BACKGROUND (AI)" Style="{DynamicResource FieldLabel}"/>
                                        <ComboBox x:Name="inlineCameraBgBox" SelectionChanged="InlineCameraBg_Changed" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="inlineCameraDeviceLabel" Text="" Foreground="{DynamicResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Button x:Name="inlineCameraRemoveBtn" Content="Remove Camera" Style="{DynamicResource ToolButton}" Height="30" HorizontalAlignment="Left" Margin="0,0,0,4" Click="InlineCameraRemove_Click" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <StackPanel x:Name="inlineRecorderFpsPanel">
                                        <TextBlock Text="FRAME RATE (FPS)" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="inlineRecorderFpsBox" Text="30" Width="90" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    </StackPanel>

                                    <StackPanel x:Name="inlineRecorderOutputPanel">
                                        <TextBlock Text="OUTPUT FILE" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="inlineRecorderPathBox" TextWrapping="NoWrap" Margin="0,0,0,10"/>
                                    </StackPanel>

                                    <TextBlock Text="Use the sidebar before Start: Add Hide Block adds a mask, Camera Recorder adds a camera layer." Foreground="{DynamicResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="inlineRecorderStartBtn" Content="Start" Style="{DynamicResource PrimaryButton}" Click="InlineRecorderStart_Click" Height="34" MinWidth="96" Margin="0,0,8,0"/>
                                        <Button x:Name="inlineRecorderStopBtn" Content="Stop + Add" Style="{DynamicResource ToolButton}" Click="InlineRecorderStop_Click" Height="34" MinWidth="112" IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- =========== TEXT TO SPEECH PANEL =========== -->
                            <Border x:Name="ttsInspectorPanel" Visibility="Collapsed">
                                <StackPanel Margin="14,12,14,14">
                                    <TextBlock Text="TEXT" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="ttsTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                    <TextBlock Text="VOICE" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox x:Name="ttsVoiceBox" Margin="0,0,0,10"/>

                                    <TextBlock Text="RATE" Style="{DynamicResource FieldLabel}"/>
                                    <Slider x:Name="ttsRateSlider" Minimum="-10" Maximum="10" Value="0" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button x:Name="ttsPreviewBtn" Content="▶ Preview" Style="{DynamicResource ToolButton}" Click="TtsPreview_Click" Height="34" MinWidth="110"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="ttsAddToTimelineBtn" Content="➕ Add to Timeline" Style="{DynamicResource PrimaryButton}" Click="TtsAddToTimeline_Click" Height="34" MinWidth="150" Margin="0,0,8,0"/>
                                        <Button x:Name="ttsSaveBtn" Content="💾 Save to disk" Style="{DynamicResource ToolButton}" Click="TtsSaveWav_Click" Height="34" MinWidth="130"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ttsStatusText" Text="" Foreground="{DynamicResource TextDim}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ========================================================
             TIMELINE
             ======================================================== -->
        <ctl:Timeline x:Name="timeline" Grid.Row="2"/>

        <!-- ========================================================
             STATUS BAR
             ======================================================== -->
        <Border Grid.Row="3" Background="{DynamicResource StatusbarBg}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#4CAF50" BlurRadius="6" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="FFmpeg 6.1 · ffprobe ready" FontSize="11" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextDim}" Margin="6,0"/>
                    <TextBlock x:Name="statusCache" Text="Cache: 0 thumbnails" FontSize="11" Foreground="{DynamicResource TextMute}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="Space" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}"/>
                    </Border>
                    <TextBlock Text="Play" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="S" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}"/>
                    </Border>
                    <TextBlock Text="Split" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="Del" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}"/>
                    </Border>
                    <TextBlock Text="Delete" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="Ctrl+C/V" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextMute}"/>
                    </Border>
                    <TextBlock Text="Copy/Paste" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="statusBranch" Text="YossiYad/video-editor · master" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
