<Window x:Class="VideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VideoEditor.Controls"
        Title="VideoEditor — Pro" Height="900" Width="1440" Background="#060709"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Heebo"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- topbar -->
            <RowDefinition Height="*"/>     <!-- workspace -->
            <RowDefinition Height="332"/>   <!-- timeline -->
            <RowDefinition Height="28"/>    <!-- statusbar -->
        </Grid.RowDefinitions>

        <!-- ========== TOPBAR ========== -->
        <Border Grid.Row="0" Background="{StaticResource TopbarBg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Project + Open -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="openBtn" Content="📂  Open" Style="{StaticResource GhostButton}" Click="OpenBtn_Click" Padding="10,8"/>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Width="1" Height="28" Margin="10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="projectName" Text="video_editor_project" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock x:Name="projDims" Text="1920×1080" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                            <Ellipse Width="3" Height="3" Fill="{StaticResource TextDim}" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="projFps" Text="29.97 fps" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                            <Ellipse Width="3" Height="3" Fill="{StaticResource TextDim}" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="H.264" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Transport + time + volume (centered) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="prevClipBtn" Content="⏮" Width="32" Height="32" Style="{StaticResource GhostButton}" Click="PrevClip_Click" FontSize="14" Padding="0"/>
                    <Button x:Name="back5Btn" Content="-5s" Width="36" Height="32" Style="{StaticResource GhostButton}" Click="Back5_Click" FontSize="11" Padding="0"/>
                    <Button x:Name="playBtn" Content="▶" Width="44" Height="36" Style="{StaticResource PrimaryButton}" Click="PlayBtn_Click" FontSize="16" Margin="3,0"/>
                    <Button x:Name="pauseBtn" Content="⏸" Width="32" Height="32" Style="{StaticResource GhostButton}" Click="PauseBtn_Click" FontSize="14" Padding="0"/>
                    <Button x:Name="stopBtn" Content="■" Width="32" Height="32" Style="{StaticResource GhostButton}" Click="StopBtn_Click" FontSize="11" Padding="0"/>
                    <Button x:Name="fwd5Btn" Content="+5s" Width="36" Height="32" Style="{StaticResource GhostButton}" Click="Fwd5_Click" FontSize="11" Padding="0"/>
                    <Button x:Name="nextClipBtn" Content="⏭" Width="32" Height="32" Style="{StaticResource GhostButton}" Click="NextClip_Click" FontSize="14" Padding="0"/>

                    <!-- Time display -->
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="11,5" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="curTimeText" Text="00:00.000" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Text}"/>
                            <TextBlock Text=" / " FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="4,0"/>
                            <TextBlock x:Name="totTimeText" Text="00:00.000" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextMute}"/>
                        </StackPanel>
                    </Border>

                    <!-- Volume -->
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔊" FontSize="13" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="volumeSlider" Minimum="0" Maximum="100" Value="80" Width="88" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                            <TextBlock x:Name="volText" Text="80" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMute}" Width="22" TextAlignment="Right" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status + Export (right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Height="32" Margin="0,0,12,0"/>
                    <StackPanel Width="240" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="statusDot" Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#4CAF50" BlurRadius="6" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="status" Text="Ready · drop video files to add" FontSize="11.5" Foreground="{StaticResource TextMute}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Height="6" Margin="0,4,0,0">
                            <ProgressBar x:Name="progress" Minimum="0" Maximum="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="settingsBtn" Style="{StaticResource ToolButton}" Click="Settings_Click" Width="36" Height="36" Padding="0" ToolTip="Settings  ·  ,">
                        <TextBlock Text="⚙" FontSize="16" Foreground="{StaticResource Text}"/>
                    </Button>

                    <Grid Width="36" Height="36" Margin="6,0">
                        <Button x:Name="helpBtn" Style="{StaticResource ToolButton}" Click="Help_Click" Width="36" Height="36" Padding="0" ToolTip="User Guide  ·  ?  /  F1">
                            <TextBlock Text="?" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        </Button>
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#8B5CFF" BlurRadius="6" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <Button x:Name="saveBtn" Style="{StaticResource SuccessButton}" Click="SaveBtn_Click" Height="36" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== WORKSPACE ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="312"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineStrong}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand header -->
                    <Border DockPanel.Dock="Top" Height="48" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Bg3}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                <TextBlock Text="▶" Foreground="#A07CFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="VideoEditor" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="v 1.4 · FFmpeg backend" FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quick stats -->
                    <Border DockPanel.Dock="Top" Margin="10,8" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="statClips" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Center"/>
                                <TextBlock Text="CLIPS" FontSize="9.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Height="22" Fill="{StaticResource Line}"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="statBlocks" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Center"/>
                                <TextBlock Text="HIDE BLOCKS" FontSize="9.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Height="22" Fill="{StaticResource Line}"/>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="●" Foreground="{StaticResource Success}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="FFMPEG" FontSize="9.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Footer (compact) -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="{StaticResource Success}" FontSize="10"/>
                            <TextBlock Text=" FFmpeg 6.1" FontSize="10.5" Foreground="{StaticResource TextMute}" Margin="4,0,0,0"/>
                            <TextBlock Text="ready" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" Margin="40,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tool groups -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,0">
                        <StackPanel Margin="0,0,0,10">
                            <!-- Workspace -->
                            <TextBlock Text="WORKSPACE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="6,8,6,3"/>
                            <Button Style="{StaticResource SidebarToolButton}" Background="#247C4DFF" BorderBrush="{StaticResource Accent}" Foreground="{StaticResource Text}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Accent}" BorderBrush="{StaticResource AccentDark}" BorderThickness="1">
                                        <TextBlock Text="✎" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Video Editor" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Capture -->
                            <TextBlock Text="CAPTURE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="6,8,6,3"/>
                            <Button x:Name="btnScreenRec" Style="{StaticResource SidebarToolButton}" Click="ScreenRec_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🖥" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Screen Recorder" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTts" Style="{StaticResource SidebarToolButton}" Click="Tts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🎙" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Text to Speech" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnRecord" Style="{StaticResource SidebarToolButton}" Click="Record_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🎥" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Video Recorder" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDownloadUrl" Style="{StaticResource SidebarToolButton}" Click="DownloadUrl_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Accent}" BorderBrush="{StaticResource AccentDark}" BorderThickness="1">
                                        <TextBlock Text="🌐" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Download from URL" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Transform & Trim -->
                            <TextBlock Text="TRANSFORM &amp; TRIM" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="6,8,6,3"/>
                            <Button x:Name="btnMerge" Style="{StaticResource SidebarToolButton}" Click="Merge_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔗" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Merge Videos" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTrim" Style="{StaticResource SidebarToolButton}" Click="Trim_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="✂" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Trim Video" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCrop" Style="{StaticResource SidebarToolButton}" Click="Crop_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="◳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Crop Video" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnRotate" Style="{StaticResource SidebarToolButton}" Click="Rotate_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="↻" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Rotate Video" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnFlip" Style="{StaticResource SidebarToolButton}" Click="Flip_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="⇄" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Flip Video" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnResize" Style="{StaticResource SidebarToolButton}" Click="Resize_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="⛶" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Resize Video" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLoop" Style="{StaticResource SidebarToolButton}" Click="Loop_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔁" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Loop Video" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnSpeed" Style="{StaticResource SidebarToolButton}" Click="Speed_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="⏩" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Change Speed" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnStabilize" Style="{StaticResource SidebarToolButton}" Click="Stabilize_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🤚" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Stabilize" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="2-pass" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <!-- Overlays -->
                            <TextBlock Text="OVERLAYS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="6,8,6,3"/>
                            <Button x:Name="btnRemoveLogo" Style="{StaticResource SidebarToolButton}" Click="RemoveLogo_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🚫" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Remove Logo" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnAddImage" Style="{StaticResource SidebarToolButton}" Click="AddImage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🖼" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Add Image" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnAddText" Style="{StaticResource SidebarToolButton}" Click="AddText_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔤" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Add Text" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Audio -->
                            <TextBlock Text="AUDIO" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="6,8,6,3"/>
                            <Button x:Name="btnAddAudio" Style="{StaticResource SidebarToolButton}" Click="AddAudio_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🎵" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Add Audio" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnVolume" Style="{StaticResource SidebarToolButton}" Click="Volume_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔊" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Change Volume" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnExtractAudio" Style="{StaticResource SidebarToolButton}" Click="ExtractAudio_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="↗" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Extract Audio" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnMuteAudio" Style="{StaticResource SidebarToolButton}" Click="MuteAudio_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🔇" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Mute / Remove Audio" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Blocks -->
                            <TextBlock Text="HIDE BLOCKS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="6,8,6,3"/>
                            <Button x:Name="addBlockBtn" Style="{StaticResource SidebarToolButton}" Click="AddBlock_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource ClipPurple}" BorderBrush="{StaticResource AccentDark}" BorderThickness="1">
                                        <TextBlock Text="◼" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Add Hide Block" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="deleteBlockBtn" Style="{StaticResource SidebarToolButton}" Click="DeleteBlock_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="🗑" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Delete Block" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Split tools -->
                            <TextBlock Text="SPLIT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Padding="6,8,6,3"/>
                            <Button x:Name="splitBtn" Style="{StaticResource SidebarToolButton}" Click="Split_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="✂" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Split at Playhead" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="S" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="splitNBtn" Style="{StaticResource SidebarToolButton}" Click="SplitN_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <TextBlock Text="⋯" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" Split into N Parts…" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== CENTER PREVIEW ===== -->
            <Grid Grid.Column="1" Background="#080812">
                <Grid Margin="20,18,20,16" x:Name="videoContainer">
                    <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Background="Black" CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="32" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <Grid x:Name="videoStack" ClipToBounds="True">
                            <MediaElement x:Name="videoView" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True" Stretch="Uniform"
                                          MediaOpened="VideoView_MediaOpened"
                                          MediaEnded="VideoView_MediaEnded"/>
                            <Canvas x:Name="overlayCanvas" Background="Transparent"/>

                            <!-- HUD strip at bottom -->
                            <Border VerticalAlignment="Bottom" Background="#CC0A0C12" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Ellipse x:Name="hudDot" Width="8" Height="8" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD43B" BlurRadius="6" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock x:Name="hudClipName" Text="No clip loaded" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="hudTimeWithin" Text="--:--" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMute}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                                        <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                            <TextBlock x:Name="hudBlocks" Text="0 blocks" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMute}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== INSPECTOR ===== -->
            <Border Grid.Column="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,18">
                        <TextBlock Text="INSPECTOR" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>

                        <!-- Clip props -->
                        <Border x:Name="clipPanel" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="6" Height="14" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" Selected Clip" FontWeight="Bold" Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Label Content="NAME"/>
                                <TextBlock x:Name="clipNameText" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12.5" Margin="0,2,0,8"/>
                                <Label Content="IN / OUT (s)"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="clipInBox" TextChanged="ClipInOut_Changed"/>
                                    <TextBox x:Name="clipOutBox" Grid.Column="1" Margin="6,0,0,0" TextChanged="ClipInOut_Changed"/>
                                </Grid>
                                <Label Content="SPEED" Margin="0,8,0,0"/>
                                <Slider x:Name="clipSpeedSlider" Minimum="0.25" Maximum="4" Value="1" ValueChanged="ClipSpeed_Changed"/>
                                <TextBlock x:Name="clipSpeedLabel" Foreground="{StaticResource TextMute}" Text="1.00×" FontSize="11" FontFamily="Consolas"/>
                                <Label Content="VOLUME" Margin="0,4,0,0"/>
                                <Slider x:Name="clipVolSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="ClipVol_Changed"/>
                                <TextBlock x:Name="clipVolLabel" Foreground="{StaticResource TextMute}" Text="100%" FontSize="11" FontFamily="Consolas"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="↻ 90°" Style="{StaticResource ToolButton}" Click="ClipRotate_Click" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="↺ -90°" Style="{StaticResource ToolButton}" Click="ClipRotateLeft_Click" HorizontalContentAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="⇄ Flip H" Style="{StaticResource ToolButton}" Click="ClipFlipH_Click" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="⇅ Flip V" Style="{StaticResource ToolButton}" Click="ClipFlipV_Click" HorizontalContentAlignment="Center"/>
                                </Grid>
                                <Button Content="🗑 Delete Clip" Style="{StaticResource ToolButton}" Click="ClipDelete_Click" Margin="0,8,0,0" HorizontalContentAlignment="Center" Foreground="{StaticResource Danger}"/>
                            </StackPanel>
                        </Border>

                        <!-- Block props -->
                        <Border x:Name="blockPanel" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="6" Height="14" CornerRadius="2" Background="{StaticResource ClipPurple}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" Selected Block" FontWeight="Bold" Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Label Content="LABEL"/>
                                <TextBox x:Name="lblBox" TextChanged="LblBox_Changed"/>
                                <Label Content="MODE" Margin="0,8,0,0"/>
                                <ComboBox x:Name="modeBox" SelectionChanged="Mode_Changed">
                                    <ComboBoxItem Content="Solid" IsSelected="True"/>
                                    <ComboBoxItem Content="Blur"/>
                                    <ComboBoxItem Content="Pixelate"/>
                                </ComboBox>
                                <Label Content="COLOR (SOLID)" Margin="0,8,0,0"/>
                                <WrapPanel>
                                    <Button Tag="Black" Background="Black" Width="22" Height="22" Margin="2" Click="Color_Click"/>
                                    <Button Tag="White" Background="White" Width="22" Height="22" Margin="2" Click="Color_Click"/>
                                    <Button Tag="Red" Background="#FF6B6B" Width="22" Height="22" Margin="2" Click="Color_Click"/>
                                    <Button Tag="Green" Background="#51CF66" Width="22" Height="22" Margin="2" Click="Color_Click"/>
                                    <Button Tag="Blue" Background="#00B8D9" Width="22" Height="22" Margin="2" Click="Color_Click"/>
                                    <Button Tag="Yellow" Background="#FFD43B" Width="22" Height="22" Margin="2" Click="Color_Click"/>
                                </WrapPanel>
                                <Label Content="BLUR / PIXEL STRENGTH" Margin="0,8,0,0"/>
                                <Slider x:Name="strengthSlider" Minimum="2" Maximum="60" Value="25" ValueChanged="Strength_Changed"/>
                                <CheckBox x:Name="wholeCheck" Content="Cover whole timeline" Foreground="{StaticResource Text}" Margin="0,10,0,0" Checked="Whole_Changed" Unchecked="Whole_Changed"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="START (s)"/>
                                        <TextBox x:Name="startBox" TextChanged="StartEnd_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <Label Content="END (s)"/>
                                        <TextBox x:Name="endBox" TextChanged="StartEnd_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Empty state -->
                        <Border x:Name="emptyInspector" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,4,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="No selection" Foreground="{StaticResource TextMute}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Click a clip or hide block to edit its properties." Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========== TIMELINE ========== -->
        <ctl:Timeline x:Name="timeline" Grid.Row="2"/>

        <!-- ========== STATUS BAR ========== -->
        <Border Grid.Row="3" Background="{StaticResource StatusbarBg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#4CAF50" BlurRadius="6" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="FFmpeg 6.1 · ffprobe ready" FontSize="11" Foreground="{StaticResource Text}"/>
                    <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextDim}" Margin="6,0"/>
                    <TextBlock x:Name="statusCache" Text="Cache: 0 thumbnails" FontSize="11" Foreground="{StaticResource TextMute}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="Space" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMute}"/>
                    </Border>
                    <TextBlock Text="Play" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="S" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMute}"/>
                    </Border>
                    <TextBlock Text="Split" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="Del" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMute}"/>
                    </Border>
                    <TextBlock Text="Delete" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="Ctrl+C/V" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMute}"/>
                    </Border>
                    <TextBlock Text="Copy/Paste" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="statusBranch" Text="YossiYad/video-editor · master" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
