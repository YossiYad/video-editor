# Build output
bin/
obj/
dist/
publish/

# Visual Studio
.vs/
*.user
*.suo
*.userprefs

# FFmpeg binaries (downloaded at runtime)
ffmpeg/
*.exe
*.dll

# Temp files
*.tmp
~$*
*.cache

# OS
Thumbs.db
.DS_Store

# Per-install user settings (contains LLM API keys, never commit)
settings.json
**/settings.json

# Whisper.cpp binaries + models (downloaded at runtime)
whisper/

# MODNet AI background model (downloaded at runtime). Anchored to the repo root and
# bin output so it does NOT match source folders like VideoEditor.Core/Models/
# (git is case-insensitive on Windows).
/models/
**/bin/**/models/

# RUN.cmd cache (release ZIP downloaded when .NET SDK is missing)
.launcher-cache/
